# ---------------------------------------------------------------------------
# Environment example — copy to `.env` (never commit real secrets)
# ---------------------------------------------------------------------------

# Docker Compose internal hostname (used by backend/worker containers via compose env).
# For host-side local development against Compose Postgres, use localhost:5433 instead:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_job_assistant
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_job_assistant

# Backend
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Frontend (Next.js) — public URL only; never put secrets here
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=10
# Inside Compose use http://backend:8000 ; locally use http://localhost:8000
BACKEND_URL=http://backend:8000

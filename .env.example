# ---------------------------------------------------------------------------
# Environment example — copy to `.env` (never commit real secrets)
# ---------------------------------------------------------------------------

# Docker Compose internal hostname (used by backend/worker containers via compose env).
# For host-side local development against Compose Postgres, use localhost:5433 instead:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ai_job_assistant
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_job_assistant

# Backend
BACKEND_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Job import pipeline (Phase 3 Step 1)
JOB_IMPORT_ENABLED=true

# Automated job search (Phase 3 Step 2)
JOB_SEARCH_ENABLED=true
SEARCH_MIN_INTERVAL_SECONDS=60
MAX_JOBS_PER_SEARCH=50
MAX_SEARCHES_PER_CYCLE=3
# Optional: permitted Indeed JSON feed (file path or URL you control).
# Without these, Indeed search reports "source unavailable" — use mock or CSV/JSON import.
# INDEED_APPROVED_FEED_PATH=
# INDEED_APPROVED_FEED_URL=

# Frontend (Next.js) — public URL only; never put secrets here
NEXT_PUBLIC_API_URL=http://localhost:8000

# Worker
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=10
# Inside Compose use http://backend:8000 ; locally use http://localhost:8000
BACKEND_URL=http://backend:8000
JOB_SEARCH_ENABLED=true
